  "assets": [
    {
      "asset_id": "VO_PRO_MARA_001",
      "dialogue_id": "PRO_MARA_001",
      "chapter": "PRO",
      "text": "Ugh... Still breathing. Radio... Nadiya? Elias? Anyone?",
      "path": "res://audio/dialogue/mara/VO_PRO_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.922630385487528,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_PRO_MARA_002",
      "dialogue_id": "PRO_MARA_002",
      "chapter": "PRO",
      "text": "Right. Up. One step at a time.",
      "path": "res://audio/dialogue/mara/VO_PRO_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 2.089795918367347,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_PRO_MARA_003",
      "dialogue_id": "PRO_MARA_003",
      "chapter": "PRO",
      "text": "This stone... it's vibrating. Not from seismic tremors. It's humming.",
      "path": "res://audio/dialogue/mara/VO_PRO_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.96907029478458,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_PRO_MARA_004",
      "dialogue_id": "PRO_MARA_004",
      "chapter": "PRO",
      "text": "What did we find?",
      "path": "res://audio/dialogue/mara/VO_PRO_MARA_004.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 1.1145578231292517,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_MARA_001",
      "dialogue_id": "C01_MARA_001",
      "chapter": "C01",
      "text": "Made it through the ridge. The expedition camp is just ahead.",
      "path": "res://audio/dialogue/mara/VO_C01_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.575873015873016,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_NADIYA_001",
      "dialogue_id": "C01_NADIYA_001",
      "chapter": "C01",
      "text": "You made it, Mara. Elias is waiting by the survey table.",
      "path": "res://audio/dialogue/nadiya/VO_C01_NADIYA_001.wav",
      "voice_id": "XrExE9yKIg1WjnnlVkGX",
      "radio": false,
      "duration": 3.4829931972789114,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_NADIYA_002",
      "dialogue_id": "C01_NADIYA_002",
      "chapter": "C01",
      "text": "Get moving, Mara. The satellite pass was clear, but clouds are gathering.",
      "path": "res://audio/dialogue/nadiya/VO_C01_NADIYA_002.wav",
      "voice_id": "XrExE9yKIg1WjnnlVkGX",
      "radio": false,
      "duration": 4.73687074829932,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_ELIAS_001",
      "dialogue_id": "C01_ELIAS_001",
      "chapter": "C01",
      "text": "Mara! Look at the satellite telemetry on the table. We found a sub-ridge anomaly.",
      "path": "res://audio/dialogue/elias/VO_C01_ELIAS_001.wav",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "radio": false,
      "duration": 5.061950113378685,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_ELIAS_002",
      "dialogue_id": "C01_ELIAS_002",
      "chapter": "C01",
      "text": "Head up the eastern trail toward the waterfall gorge. Be careful on the rock ledges.",
      "path": "res://audio/dialogue/elias/VO_C01_ELIAS_002.wav",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "radio": false,
      "duration": 5.294149659863946,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_MARA_002",
      "dialogue_id": "C01_MARA_002",
      "chapter": "C01",
      "text": "Symmetrical subterranean chambers... That's not a natural fault. I'll check the eastern ridge.",
      "path": "res://audio/dialogue/mara/VO_C01_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 6.176507936507937,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_MARA_003",
      "dialogue_id": "C01_MARA_003",
      "chapter": "C01",
      "text": "Elias... I found it. A massive sealed stone doorway carved right into the mountain cliff.",
      "path": "res://audio/dialogue/mara/VO_C01_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.990748299319728,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_ELIAS_003",
      "dialogue_id": "C01_ELIAS_003",
      "chapter": "C01",
      "text": "Incredible! Don't touch anything yet. I'm bringing Tomas and the equipment.",
      "path": "res://audio/dialogue/elias/VO_C01_ELIAS_003.wav",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "radio": true,
      "duration": 4.922630385487528,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_MARA_004",
      "dialogue_id": "C01_MARA_004",
      "chapter": "C01",
      "text": "The carvings match the Vaelor texts... This is where it begins.",
      "path": "res://audio/dialogue/mara/VO_C01_MARA_004.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.9938321995464854,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_MARA_005",
      "dialogue_id": "C01_MARA_005",
      "chapter": "C01",
      "text": "Field note. Waterfall chambers match the Vaelor survey. We document before we disturb.",
      "path": "res://audio/dialogue/mara/VO_C01_MARA_005.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.479909297052155,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_TOMAS_001",
      "dialogue_id": "C01_TOMAS_001",
      "chapter": "C01",
      "text": "Climbing kit is checked. If the weather turns, we come back together.",
      "path": "res://audio/dialogue/tomas/VO_C01_TOMAS_001.wav",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "radio": false,
      "duration": 3.8545124716553287,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C01_ADRIAN_001",
      "dialogue_id": "C01_ADRIAN_001",
      "chapter": "C01",
      "text": "The eastern contour is verified. I will keep the survey beacon running.",
      "path": "res://audio/dialogue/adrian/VO_C01_ADRIAN_001.wav",
      "voice_id": "cjVigY5qzO86Huf0OWal",
      "radio": false,
      "duration": 3.7151927437641725,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C02_MARA_001",
      "dialogue_id": "C02_MARA_001",
      "chapter": "C02",
      "text": "The gate is locked by an ancient hydraulic counterweight. The water channel is blocked.",
      "path": "res://audio/dialogue/mara/VO_C02_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.829750566893424,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C02_MARA_002",
      "dialogue_id": "C02_MARA_002",
      "chapter": "C02",
      "text": "Water's diverted into the conduit! The counterweight is filling.",
      "path": "res://audio/dialogue/mara/VO_C02_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.6687528344671203,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C02_MARA_003",
      "dialogue_id": "C02_MARA_003",
      "chapter": "C02",
      "text": "The Voice Below...\" It refers to a subterranean harmonic nexus deep in the mountain core.",
      "path": "res://audio/dialogue/mara/VO_C02_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.572789115646258,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C02_TOMAS_001",
      "dialogue_id": "C02_TOMAS_001",
      "chapter": "C02",
      "text": "Mara, Elias is bringing the bridge rig across now!",
      "path": "res://audio/dialogue/tomas/VO_C02_TOMAS_001.wav",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "radio": true,
      "duration": 2.693514739229025,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C02_MARA_004",
      "dialogue_id": "C02_MARA_004",
      "chapter": "C02",
      "text": "The inscription says the stone listens. These chambers carry sound like roads carry people.",
      "path": "res://audio/dialogue/mara/VO_C02_MARA_004.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.526349206349207,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C03_ELIAS_001",
      "dialogue_id": "C03_ELIAS_001",
      "chapter": "C03",
      "text": "Mara, take the center line! The stone anchors look brittle.",
      "path": "res://audio/dialogue/elias/VO_C03_ELIAS_001.wav",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "radio": true,
      "duration": 3.575873015873016,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C03_MARA_001",
      "dialogue_id": "C03_MARA_001",
      "chapter": "C03",
      "text": "The anchors are giving way! JUMP!",
      "path": "res://audio/dialogue/mara/VO_C03_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 1.9040362811791383,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C03_MARA_002",
      "dialogue_id": "C03_MARA_002",
      "chapter": "C03",
      "text": "ELIAS!...",
      "path": "res://audio/dialogue/mara/VO_C03_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 0.8823582766439909,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C03_MARA_003",
      "dialogue_id": "C03_MARA_003",
      "chapter": "C03",
      "text": "The bridge was built to move with the mountain. Someone cut its safety anchors.",
      "path": "res://audio/dialogue/mara/VO_C03_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.08671201814059,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C04_MARA_001",
      "dialogue_id": "C04_MARA_001",
      "chapter": "C04",
      "text": "Underground... Water broke my fall. I need to find high ground and radio contact.",
      "path": "res://audio/dialogue/mara/VO_C04_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.061950113378685,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C04_NADIYA_001",
      "dialogue_id": "C04_NADIYA_001",
      "chapter": "C04",
      "text": "Mara?! Thank God! Be careful\u2014armed contractors are breaching the valley!",
      "path": "res://audio/dialogue/nadiya/VO_C04_NADIYA_001.wav",
      "voice_id": "XrExE9yKIg1WjnnlVkGX",
      "radio": true,
      "duration": 5.294149659863946,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C04_MARA_002",
      "dialogue_id": "C04_MARA_002",
      "chapter": "C04",
      "text": "Voices ahead... Flashlights in the darkness. Meridian is here.",
      "path": "res://audio/dialogue/mara/VO_C04_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.9938321995464854,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C04_MARA_003",
      "dialogue_id": "C04_MARA_003",
      "chapter": "C04",
      "text": "An old survey camp. They found this passage a century ago, then turned back.",
      "path": "res://audio/dialogue/mara/VO_C04_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.108390022675737,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C05_MARA_001",
      "dialogue_id": "C05_MARA_001",
      "chapter": "C05",
      "text": "Meridian mercenaries ahead. Stay low, use cover, or take them down quietly.",
      "path": "res://audio/dialogue/mara/VO_C05_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.829750566893424,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C05_DRAKE_001",
      "dialogue_id": "C05_DRAKE_001",
      "chapter": "C05",
      "text": "Vale's team found the door. Secure the subterranean aqueduct immediately.",
      "path": "res://audio/dialogue/drake/VO_C05_DRAKE_001.wav",
      "voice_id": "onwK4e9ZLuTAKqWW03F9",
      "radio": false,
      "duration": 5.061950113378685,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C05_MARA_002",
      "dialogue_id": "C05_MARA_002",
      "chapter": "C05",
      "text": "Water's rushing into the temple basin. Time to dive.",
      "path": "res://audio/dialogue/mara/VO_C05_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.0650340136054424,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C05_MARA_003",
      "dialogue_id": "C05_MARA_003",
      "chapter": "C05",
      "text": "Meridian crates. This was planned before we opened the portal. Someone gave them our route.",
      "path": "res://audio/dialogue/mara/VO_C05_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.201269841269841,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C05_MERIDIAN_001",
      "dialogue_id": "C05_MERIDIAN_001",
      "chapter": "C05",
      "text": "Hold the lower passage. No one enters without clearance.",
      "path": "res://audio/dialogue/meridian/VO_C05_MERIDIAN_001.wav",
      "voice_id": "CwhRBWXzGAHq8TQ4Fs17",
      "radio": false,
      "duration": 3.3436734693877552,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C06_MARA_001",
      "dialogue_id": "C06_MARA_001",
      "chapter": "C06",
      "text": "The temple is half-submerged. I need to drain the central basin to reach the inner sanctum.",
      "path": "res://audio/dialogue/mara/VO_C06_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.2477097505668935,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C06_MARA_002",
      "dialogue_id": "C06_MARA_002",
      "chapter": "C06",
      "text": "The aqueduct is flushing out! The lower gate is emerging from the water.",
      "path": "res://audio/dialogue/mara/VO_C06_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.2260317460317465,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C06_MARA_003",
      "dialogue_id": "C06_MARA_003",
      "chapter": "C06",
      "text": "Nadiya... I found a city. A colossal subterranean metropolis.",
      "path": "res://audio/dialogue/mara/VO_C06_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.040272108843538,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C06_MARA_004",
      "dialogue_id": "C06_MARA_004",
      "chapter": "C06",
      "text": "The temple's water channels regulate pressure. The flood is damage, not a trap.",
      "path": "res://audio/dialogue/mara/VO_C06_MARA_004.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.783310657596372,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C07_MARA_001",
      "dialogue_id": "C07_MARA_001",
      "chapter": "C07",
      "text": "The City of Echoes... Cyclopean towers stretching into the shadows. The Heart Vault is ahead.",
      "path": "res://audio/dialogue/mara/VO_C07_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.61922902494331,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C07_MARA_002",
      "dialogue_id": "C07_MARA_002",
      "chapter": "C07",
      "text": "They knew the Vault was unstable... but they kept using it because it worked. Until it didn't.",
      "path": "res://audio/dialogue/mara/VO_C07_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.2477097505668935,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C07_MARA_003",
      "dialogue_id": "C07_MARA_003",
      "chapter": "C07",
      "text": "An optional challenge chamber: The Tomb of Weights. Ancient counterweight engineering.",
      "path": "res://audio/dialogue/mara/VO_C07_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.061950113378685,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C07_TOMAS_001",
      "dialogue_id": "C07_TOMAS_001",
      "chapter": "C07",
      "text": "Mara, we're holding position at the forward camp! Hurry!",
      "path": "res://audio/dialogue/tomas/VO_C07_TOMAS_001.wav",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "radio": true,
      "duration": 2.7399546485260773,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C07_MARA_004",
      "dialogue_id": "C07_MARA_004",
      "chapter": "C07",
      "text": "They left the warning where everyone could see it. We should listen to the people who lived here.",
      "path": "res://audio/dialogue/mara/VO_C07_MARA_004.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.6439909297052155,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C08_MARA_001",
      "dialogue_id": "C08_MARA_001",
      "chapter": "C08",
      "text": "I see expedition gear ahead! Elias, Nadiya!",
      "path": "res://audio/dialogue/mara/VO_C08_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.0650340136054424,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C08_ELIAS_001",
      "dialogue_id": "C08_ELIAS_001",
      "chapter": "C08",
      "text": "Mara... Adrian took the Vaelor Key. He's been transmitting coordinates to Meridian all along.",
      "path": "res://audio/dialogue/elias/VO_C08_ELIAS_001.wav",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "radio": false,
      "duration": 5.6656689342403626,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C08_ADRIAN_001",
      "dialogue_id": "C08_ADRIAN_001",
      "chapter": "C08",
      "text": "I'm sorry, Mara. I sold the coordinates, not your lives. Drake took the Key. Use the service road.",
      "path": "res://audio/dialogue/adrian/VO_C08_ADRIAN_001.wav",
      "voice_id": "cjVigY5qzO86Huf0OWal",
      "radio": true,
      "duration": 5.526349206349207,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C08_MARA_002",
      "dialogue_id": "C08_MARA_002",
      "chapter": "C08",
      "text": "Elias trusted Adrian's survey. So did I. Trust is not proof; the transmission log is.",
      "path": "res://audio/dialogue/mara/VO_C08_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 6.408707482993197,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C08_MARA_003",
      "dialogue_id": "C08_MARA_003",
      "chapter": "C08",
      "text": "You gave him the way in. Help us get everyone out.",
      "path": "res://audio/dialogue/mara/VO_C08_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.01859410430839,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C08_ELIAS_002",
      "dialogue_id": "C08_ELIAS_002",
      "chapter": "C08",
      "text": "The Key opens the Vault, Mara. The four outer nodes can still stop it.",
      "path": "res://audio/dialogue/elias/VO_C08_ELIAS_002.wav",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "radio": false,
      "duration": 4.31891156462585,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C09_MARA_001",
      "dialogue_id": "C09_MARA_001",
      "chapter": "C09",
      "text": "The entire mountain is trembling. Meridian's blasting destabilized the resonance conduits.",
      "path": "res://audio/dialogue/mara/VO_C09_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.433469387755102,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C09_MARA_002",
      "dialogue_id": "C09_MARA_002",
      "chapter": "C09",
      "text": "Ceiling collapse! Keep moving!",
      "path": "res://audio/dialogue/mara/VO_C09_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 1.811156462585034,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C09_MARA_003",
      "dialogue_id": "C09_MARA_003",
      "chapter": "C09",
      "text": "This is it. The threshold of the Heart Vault. Drake is inside.",
      "path": "res://audio/dialogue/mara/VO_C09_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.7616326530612243,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C09_MARA_004",
      "dialogue_id": "C09_MARA_004",
      "chapter": "C09",
      "text": "The Heart Road carries the city's resonance. Every blast travels farther than they know.",
      "path": "res://audio/dialogue/mara/VO_C09_MARA_004.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.340589569160998,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C10_MARA_001",
      "dialogue_id": "C10_MARA_001",
      "chapter": "C10",
      "text": "The Heart Vault... The resonance in this chamber is deafening. There's Drake.",
      "path": "res://audio/dialogue/mara/VO_C10_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.551111111111111,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C10_DRAKE_001",
      "dialogue_id": "C10_DRAKE_001",
      "chapter": "C10",
      "text": "Do you know what this is, Vale? A machine capable of transmitting tectonic kinetic energy across continents!",
      "path": "res://audio/dialogue/drake/VO_C10_DRAKE_001.wav",
      "voice_id": "onwK4e9ZLuTAKqWW03F9",
      "radio": false,
      "duration": 7.291065759637188,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C10_MARA_002",
      "dialogue_id": "C10_MARA_002",
      "chapter": "C10",
      "text": "Node deactivated! Resonance dampening.",
      "path": "res://audio/dialogue/mara/VO_C10_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 2.3219954648526078,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C10_DRAKE_002",
      "dialogue_id": "C10_DRAKE_002",
      "chapter": "C10",
      "text": "No! What did you do?! The feedback is tearing the platform apart!",
      "path": "res://audio/dialogue/drake/VO_C10_DRAKE_002.wav",
      "voice_id": "onwK4e9ZLuTAKqWW03F9",
      "radio": false,
      "duration": 4.597551020408163,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C10_MARA_003",
      "dialogue_id": "C10_MARA_003",
      "chapter": "C10",
      "text": "Drake, get out! It's over! RUN!",
      "path": "res://audio/dialogue/mara/VO_C10_MARA_003.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 1.9504761904761905,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C10_MARA_004",
      "dialogue_id": "C10_MARA_004",
      "chapter": "C10",
      "text": "Four nodes hold the network in balance. Break the feedback, and Drake loses the core.",
      "path": "res://audio/dialogue/mara/VO_C10_MARA_004.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 5.015510204081632,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C10_MARA_005",
      "dialogue_id": "C10_MARA_005",
      "chapter": "C10",
      "text": "The Vaelor sealed this place for a reason. You are repeating their mistake.",
      "path": "res://audio/dialogue/mara/VO_C10_MARA_005.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.458231292517007,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_C10_DRAKE_003",
      "dialogue_id": "C10_DRAKE_003",
      "chapter": "C10",
      "text": "They lacked control. We have the instruments to finish what they began.",
      "path": "res://audio/dialogue/drake/VO_C10_DRAKE_003.wav",
      "voice_id": "onwK4e9ZLuTAKqWW03F9",
      "radio": false,
      "duration": 5.108390022675737,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_FIN_MARA_001",
      "dialogue_id": "FIN_MARA_001",
      "chapter": "FIN",
      "text": "I see daylight! Tomas, Nadiya, I'm almost through the eastern fissure!",
      "path": "res://audio/dialogue/mara/VO_FIN_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.504671201814059,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_FIN_TOMAS_001",
      "dialogue_id": "FIN_TOMAS_001",
      "chapter": "FIN",
      "text": "Mara! Grab my hand! I've got you!",
      "path": "res://audio/dialogue/tomas/VO_FIN_TOMAS_001.wav",
      "voice_id": "iP95p4xoKVk53GoZ742B",
      "radio": false,
      "duration": 1.6253968253968254,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_FIN_MARA_002",
      "dialogue_id": "FIN_MARA_002",
      "chapter": "FIN",
      "text": "We leave the core here. No one gets to turn their history into a weapon.",
      "path": "res://audio/dialogue/mara/VO_FIN_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.133151927437642,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_FIN_NADIYA_001",
      "dialogue_id": "FIN_NADIYA_001",
      "chapter": "FIN",
      "text": "Elias is clear. Tomas, get her away from the edge!",
      "path": "res://audio/dialogue/nadiya/VO_FIN_NADIYA_001.wav",
      "voice_id": "XrExE9yKIg1WjnnlVkGX",
      "radio": false,
      "duration": 3.4829931972789114,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_EPI_ELIAS_001",
      "dialogue_id": "EPI_ELIAS_001",
      "chapter": "EPI",
      "text": "We came looking for a discovery. You reminded us what we owe it.",
      "path": "res://audio/dialogue/elias/VO_EPI_ELIAS_001.wav",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "radio": false,
      "duration": 3.8080725623582765,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_EPI_MARA_001",
      "dialogue_id": "EPI_MARA_001",
      "chapter": "EPI",
      "text": "The survey will prove the site exists. Its location stays protected.",
      "path": "res://audio/dialogue/mara/VO_EPI_MARA_001.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 4.4117913832199545,
      "sample_rate": 44100,
      "channels": 1
    },
    {
      "asset_id": "VO_EPI_MARA_002",
      "dialogue_id": "EPI_MARA_002",
      "chapter": "EPI",
      "text": "Some stories survive because we leave them where they belong.",
      "path": "res://audio/dialogue/mara/VO_EPI_MARA_002.wav",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "radio": false,
      "duration": 3.5294331065759637,
      "sample_rate": 44100,
      "channels": 1
    }
  ],
  "reserved_additional_characters": 4562
}