class_name WaterPreset
extends Resource
## Data-only description of a water look + motion. Saved presets live in
## res://systems/water/presets/*.tres (generated by dev/generate_water_presets.gd
## from WaterPreset.make()).

@export var preset_name := "CALM_CAVE_POOL"
@export_group("Waves")
## (dir.x, dir.z, amplitude m, wavelength m). Up to 4.
@export var waves: Array[Vector4] = [Vector4(1, 0.3, 0.02, 3.0), Vector4(-0.4, 1, 0.012, 1.7), Vector4(0.7, -0.6, 0.006, 0.9), Vector4(-0.9, -0.2, 0.004, 0.6)]
@export var wave_speed := 1.0
@export_group("Flow")
## Horizontal flow, world units/s. Advects normals, foam, waves and floating bodies.
@export var flow_velocity := Vector2.ZERO
@export_group("Look")
@export var shallow_color := Color(0.16, 0.42, 0.40)
@export var deep_color := Color(0.01, 0.06, 0.07)
@export var absorption := Vector3(0.45, 0.16, 0.12)
@export_range(0.0, 1.0) var clarity := 0.8
@export var refraction_strength := 0.04
@export var normal_strength := 0.6
@export var normal_a_xform := Vector4(0.12, 0.0, 0.03, 0.01)
@export var normal_b_xform := Vector4(0.31, 0.0, -0.02, 0.035)
@export var roughness_base := 0.05
@export var roughness_variation := 0.08
@export var specular_amount := 0.6
@export var foam_width := 0.6
@export var foam_amount := 0.7
@export var crest_foam := 0.0
@export_group("Physics")
@export var density := 1000.0
@export var linear_drag := 3.0
@export var angular_drag := 2.0

const NAMES := ["CALM_CAVE_POOL", "UNDERGROUND_STREAM", "FLOODED_TEMPLE", "RIVER", "WATERFALL_BASIN", "RISING_PUZZLE_WATER"]

static func make(name: String) -> WaterPreset:
	var p := WaterPreset.new()
	p.preset_name = name
	match name:
		"CALM_CAVE_POOL":
			p.waves = [Vector4(1, 0.3, 0.012, 2.8), Vector4(-0.4, 1, 0.008, 1.6), Vector4(0.7, -0.6, 0.004, 0.9), Vector4(-0.9, -0.2, 0.002, 0.5)]
			p.shallow_color = Color(0.10, 0.36, 0.38); p.deep_color = Color(0.005, 0.03, 0.045)
			p.absorption = Vector3(0.5, 0.18, 0.13); p.clarity = 0.95
			p.normal_strength = 0.35; p.foam_amount = 0.25; p.foam_width = 0.3
			p.roughness_base = 0.03
		"UNDERGROUND_STREAM":
			p.flow_velocity = Vector2(1.4, 0.0)
			p.waves = [Vector4(1, 0.1, 0.03, 1.8), Vector4(0.8, 0.6, 0.015, 0.9), Vector4(1, -0.5, 0.01, 0.6), Vector4(0.3, 1, 0.005, 0.4)]
			p.shallow_color = Color(0.14, 0.38, 0.36); p.deep_color = Color(0.01, 0.05, 0.06)
			p.normal_strength = 0.9; p.foam_amount = 1.0; p.foam_width = 0.8; p.crest_foam = 0.25
			p.roughness_base = 0.08; p.linear_drag = 4.0
		"FLOODED_TEMPLE":
			p.waves = [Vector4(1, 0.5, 0.02, 4.0), Vector4(-0.3, 1, 0.01, 2.2), Vector4(0.6, -0.8, 0.005, 1.1), Vector4(-1, -0.1, 0.003, 0.7)]
			p.shallow_color = Color(0.18, 0.34, 0.24); p.deep_color = Color(0.02, 0.05, 0.035)
			p.absorption = Vector3(0.7, 0.3, 0.35); p.clarity = 0.55
			p.normal_strength = 0.4; p.foam_amount = 0.4
		"RIVER":
			p.flow_velocity = Vector2(0.0, 2.2)
			p.waves = [Vector4(0.2, 1, 0.03, 2.9), Vector4(-0.5, 1, 0.018, 1.37), Vector4(0.7, 0.7, 0.01, 0.83), Vector4(1, 0.2, 0.005, 0.53)]
			p.shallow_color = Color(0.20, 0.40, 0.34); p.deep_color = Color(0.02, 0.07, 0.07)
			p.absorption = Vector3(0.6, 0.25, 0.22); p.clarity = 0.6
			p.normal_strength = 0.9; p.foam_amount = 1.0; p.crest_foam = 0.3; p.roughness_base = 0.1
			p.linear_drag = 4.0
		"WATERFALL_BASIN":
			p.waves = [Vector4(1, 0.13, 0.025, 1.9), Vector4(-0.6, 1, 0.018, 1.13), Vector4(0.37, -1, 0.012, 0.71), Vector4(-1, -0.7, 0.007, 0.43)]
			p.wave_speed = 1.3
			p.normal_strength = 1.1; p.foam_amount = 1.3; p.foam_width = 1.0; p.crest_foam = 0.5
			p.roughness_base = 0.15; p.roughness_variation = 0.15; p.clarity = 0.5
		"RISING_PUZZLE_WATER":
			p.waves = [Vector4(1, 0.4, 0.025, 3.2), Vector4(-0.5, 1, 0.014, 1.8), Vector4(0.6, -0.7, 0.007, 1.0), Vector4(-0.8, -0.3, 0.004, 0.6)]
			p.shallow_color = Color(0.12, 0.38, 0.40); p.deep_color = Color(0.01, 0.04, 0.06)
			p.normal_strength = 0.55; p.foam_amount = 0.8
	return p

func apply_to(mat: ShaderMaterial, low_quality: bool) -> void:
	var w := PackedVector4Array()
	for i in 4:
		w.append(waves[i] if i < waves.size() else Vector4(1, 0, 0, 1))
	mat.set_shader_parameter("waves", w)
	mat.set_shader_parameter("wave_count", wave_count(low_quality))
	mat.set_shader_parameter("wave_speed", wave_speed)
	mat.set_shader_parameter("flow_velocity", flow_velocity)
	mat.set_shader_parameter("shallow_color", shallow_color)
	mat.set_shader_parameter("deep_color", deep_color)
	mat.set_shader_parameter("normal_strength", normal_strength)
	mat.set_shader_parameter("normal_a_xform", normal_a_xform)
	mat.set_shader_parameter("roughness_base", roughness_base)
	mat.set_shader_parameter("specular_amount", specular_amount)
	if low_quality:
		return
	mat.set_shader_parameter("absorption", absorption)
	mat.set_shader_parameter("clarity", clarity)
	mat.set_shader_parameter("refraction_strength", refraction_strength)
	mat.set_shader_parameter("normal_b_xform", normal_b_xform)
	mat.set_shader_parameter("roughness_variation", roughness_variation)
	mat.set_shader_parameter("foam_width", foam_width)
	mat.set_shader_parameter("foam_amount", foam_amount)
	mat.set_shader_parameter("crest_foam", crest_foam)

func wave_count(low_quality: bool) -> int:
	return mini(waves.size(), 2 if low_quality else 4)
